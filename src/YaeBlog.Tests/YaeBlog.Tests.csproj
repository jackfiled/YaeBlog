  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YaeBlog.Typst\YaeBlog.Typst.csproj" />
    <ProjectReference Include="..\YaeBlog\YaeBlog.csproj" />
  </ItemGroup>

